{
	"format_version": "1.26.60",
  "minecraft:block": {
    "description": {
      "identifier": "cosmos:fuel_loader",
			"menu_category": { "category": "items" },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "minecraft:tags": ["cosmos", "power", "machine", "has_power_input", "has_fuel_input"],
      "minecraft:tick": {
        "interval_range": [1, 1]
      },
      "minecraft:block_entity": {
        "dynamic_properties": true,
        "container": {
          "slot_count": 9,
          "title": "§f§u§e§l§_§l§o§a§d§e§r"
        }
      },
      "cosmos:machine": {},
      "minecraft:destructible_by_explosion": false,
      "minecraft:movable": { "movement_type": "immovable" },
      "minecraft:geometry": "minecraft:geometry.full_block_v1",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:material_instances": {
        "up": { "render_method": "opaque", "texture": "machine_blank" },
        "down": { "render_method": "opaque", "texture": "machine_blank" },
        "north": { "render_method": "opaque", "texture": "fuel_loader" },
        "east": { "render_method": "opaque", "texture": "energy_input" },
        "south": { "render_method": "opaque", "texture": "fuel_loader" },
        "west": { "render_method": "opaque", "texture": "fuel_input" }
      }
    },
    "permutations": [
        {
          "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
          "components": {
            "minecraft:transformation": { "rotation": [0, 180, 0] }
          }
        },
        {
          "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
          "components": {
            "minecraft:transformation": { "rotation": [0, 90, 0] }
          }
        },
        {
          "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
          "components": {
            "minecraft:transformation": { "rotation": [0, -90, 0] }
          }
        }
    ]
  }
}