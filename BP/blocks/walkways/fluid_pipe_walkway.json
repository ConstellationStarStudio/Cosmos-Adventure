{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "cosmos:pipe_walkway",
		  "menu_category": { "category": "items" },
      "states": {
        "cosmos:fluid_up": [0, 1],
        "cosmos:fluid_down": [0, 1],
				"cosmos:fluid_north": [0, 1],
				"cosmos:fluid_east": [0, 1],
				"cosmos:fluid_south": [0, 1],
				"cosmos:fluid_west": [0, 1],
        "cosmos:tick": [false, true],
        "cosmos:liquid": ["liquid", "gas"]
			}
    },
    "components": {
      "minecraft:tags": ["fluid_pipe", "sealed_fluid_pipe"],
			"minecraft:block_entity": {
				"dynamic_properties": true
			},
			"minecraft:destructible_by_explosion": false,
      "minecraft:geometry": {
        "identifier": "geometry.fluid_pipe_walkway",
        "bone_visibility": {
					"north": "q.block_state('cosmos:fluid_north') == 1",
					"east": "q.block_state('cosmos:fluid_east') == 1",
					"south": "q.block_state('cosmos:fluid_south') == 1",
					"west": "q.block_state('cosmos:fluid_west') == 1",
          "down": "q.block_state('cosmos:fluid_down') == 1"
        }
      },
      "minecraft:material_instances": {
        "*": { "texture": "fluid_pipe_walkway", "render_method": "blend"}
      },
      "minecraft:collision_box":{
        "origin":[-8, 12, -8],
        "size":[16, 4, 16]
      },
      "minecraft:selection_box":{
          "origin":[-8, 12, -8],
          "size":[16, 4, 16]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1
      },
      "cosmos:fluid_pipe": {}
    },
    "permutations": [
			{
				"condition": "q.block_state('cosmos:tick') == true",
				"components": {
					"minecraft:tick": {
						 "interval_range": [0, 20],
						 "looping": true
          },
					"cosmos:fluid_tick": {},
					"cosmos:fluid_pipe": {}
				}
			}
		]
  }
}